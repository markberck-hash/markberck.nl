# Productie draait op Apache; deze .htaccess zorgt dat blogartikelen (.md) met het
# juiste MIME-type worden geserveerd en dat directe navigatie naar een route
# (bijv. /blog of /cv) de SPA laadt in plaats van een 404 te geven.

AddType text/markdown .md

# Voorkom dat configuratie- en projectbestanden publiek worden uitgeleverd.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule (^|/)(?:\.git|\.github|node_modules)(?:/|$) - [R=404,L,NC]
  RewriteRule (^|/)(?:README\.md|web\.config|\.htaccess|\.gitignore|\.env(?:\..*)?|[^/]+\.config)$ - [R=404,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
